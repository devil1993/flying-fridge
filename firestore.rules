rules_version = '2';

// Flying Fridge — Firestore Security Rules.
//
// Family membership is the access boundary: a `families/{familyId}` doc lists
// `memberUids`, and every board item is scoped to a family. A user may read or
// write an item only if they are a member of that item's family. Families are
// bootstrapped manually in the console for now (see
// human-instructions/03-bootstrap-family.md) — invite/join/approval comes later.

service cloud.firestore {
  match /databases/{database}/documents {

    function isMemberOf(familyId) {
      return request.auth != null
        && request.auth.uid in
           get(/databases/$(database)/documents/families/$(familyId)).data.memberUids;
    }

    // Board items: read/write only for members of the item's family.
    function itemAllowed() {
      return isMemberOf(resource.data.familyId);
    }
    function newItemAllowed() {
      return isMemberOf(request.resource.data.familyId);
    }

    match /tasks/{id} {
      allow read, update, delete: if itemAllowed();
      allow create: if newItemAllowed();
    }
    match /notices/{id} {
      allow read, update, delete: if itemAllowed();
      allow create: if newItemAllowed();
    }
    match /lostAndFound/{id} {
      allow read, update, delete: if itemAllowed();
      allow create: if newItemAllowed();
    }
    match /pantry/{id} {
      allow read, update, delete: if itemAllowed();
      allow create: if newItemAllowed();
    }
    match /questions/{id} {
      allow read, update, delete: if itemAllowed();
      allow create: if newItemAllowed();
    }

    // Families: members can read their family. Creating/editing membership is
    // console/admin only for now (invite + approval flow comes later).
    match /families/{familyId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.memberUids;
      allow write: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
