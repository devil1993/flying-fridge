# Firebase web config — copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored and must never be committed.
#
# Where these come from: human-instructions/01-firebase-project-setup.md
# These VITE_* values ship in the frontend bundle; that is expected — they
# identify the project, they do not secure it. Real protection comes from
# Firestore Security Rules (future work).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Web Push certificate (Project settings → Cloud Messaging → Web Push certificates)
VITE_FIREBASE_VAPID_KEY=
